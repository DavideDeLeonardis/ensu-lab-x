{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "suggestion_set.schema.json",
   "title": "SuggestionSet",
   "description": "What the AI layer returns for one booking request or experiment plan, and what the UI renders. All kg/kWh numbers must come from the calculator.",
   "type": "object",
   "required": [
      "request_id",
      "estimate",
      "suggestions",
      "suppressed"
   ],
   "additionalProperties": false,
   "properties": {
      "request_id": {
         "type": "string",
         "description": "e.g. 'REQ-A1-2026-10-12' (booking request) or the plan_id (experiment plan)"
      },
      "booking_ids": {
         "type": "array",
         "items": {
            "type": "string",
            "pattern": "^BK-\\d{3}$"
         }
      },
      "estimate": {
         "type": "object",
         "required": [
            "kwh",
            "kg",
            "hotspots",
            "locked_kg"
         ],
         "additionalProperties": false,
         "properties": {
            "kwh": {
               "type": "number",
               "description": "Secondary figure: kWh of the equipment involved. The headline metric is kg (CO2e)."
            },
            "kg": {
               "$ref": "#/$defs/range",
               "description": "Total kg CO2e (embodied + electricity for plans)"
            },
            "hotspots": {
               "description": "Largest contributors, sorted by share, max 4.",
               "type": "array",
               "maxItems": 4,
               "items": {
                  "type": "object",
                  "required": [
                     "kg_typ",
                     "share_pct"
                  ],
                  "additionalProperties": false,
                  "properties": {
                     "equipment_id": {
                        "type": "string"
                     },
                     "item_id": {
                        "type": "string",
                        "description": "Experiment plans: key into data/consumables.csv"
                     },
                     "kg_typ": {
                        "type": "number"
                     },
                     "share_pct": {
                        "type": "number"
                     },
                     "locked": {
                        "type": "boolean",
                        "description": "true if every booking (or plan line) on it is fixed"
                     }
                  },
                  "oneOf": [
                     {
                        "required": [
                           "equipment_id"
                        ]
                     },
                     {
                        "required": [
                           "item_id"
                        ]
                     }
                  ]
               }
            },
            "locked_kg": {
               "type": "number",
               "description": "kg CO2e in bookings with movable = no or locked plan lines (out of the tool's reach)"
            },
            "breakdown": {
               "description": "Experiment plans: kg CO2e split by source.",
               "type": "object",
               "required": [
                  "embodied",
                  "electricity"
               ],
               "additionalProperties": false,
               "properties": {
                  "embodied": {
                     "$ref": "#/$defs/range"
                  },
                  "electricity": {
                     "$ref": "#/$defs/range"
                  }
               }
            },
            "electricity": {
               "description": "Experiment plans: the electricity factor used for equipment lines.",
               "type": "object",
               "required": [
                  "basis",
                  "g_per_kwh",
                  "source"
               ],
               "additionalProperties": false,
               "properties": {
                  "basis": {
                     "type": "string",
                     "enum": [
                        "location",
                        "market"
                     ]
                  },
                  "g_per_kwh": {
                     "type": "number"
                  },
                  "source": {
                     "type": "string",
                     "description": "key into data/sources.csv"
                  }
               }
            }
         }
      },
      "suggestions": {
         "description": "At most 3, sorted by saving_kg.typ descending.",
         "type": "array",
         "maxItems": 3,
         "items": {
            "$ref": "#/$defs/suggestion"
         }
      },
      "suppressed": {
         "description": "Bookings the tool deliberately did NOT touch, with the reason. Shown on request, for transparency.",
         "type": "array",
         "items": {
            "type": "object",
            "required": [
               "reason"
            ],
            "additionalProperties": false,
            "properties": {
               "booking_id": {
                  "type": "string"
               },
               "line_id": {
                  "type": "string",
                  "pattern": "^L\\d+$"
               },
               "reason": {
                  "type": "string",
                  "enum": [
                     "hard_constraint",
                     "muted_by_user_feedback",
                     "saving_below_threshold",
                     "disabled_by_lab_manager",
                     "requirement_conflict"
                  ]
               },
               "detail": {
                  "type": "string"
               }
            },
            "oneOf": [
               {
                  "required": [
                     "booking_id"
                  ]
               },
               {
                  "required": [
                     "line_id"
                  ]
               }
            ]
         }
      },
      "line_ids": {
         "description": "Experiment plans only: the plan's line ids (mirror of booking_ids).",
         "type": "array",
         "items": {
            "type": "string",
            "pattern": "^L\\d+$"
         }
      },
      "generator": {
         "description": "Who proposed the suggestions and who wrote their text. Always set by the plan engine.",
         "type": "object",
         "required": [
            "proposer",
            "phraser"
         ],
         "additionalProperties": false,
         "properties": {
            "proposer": {
               "type": "string",
               "enum": [
                  "llm",
                  "rules"
               ]
            },
            "phraser": {
               "type": "string",
               "enum": [
                  "llm",
                  "template",
                  "mixed"
               ]
            },
            "model": {
               "type": [
                  "string",
                  "null"
               ],
               "description": "e.g. 'claude-haiku-5-5'; null when no LLM was used"
            },
            "prompt_version": {
               "type": [
                  "string",
                  "null"
               ],
               "description": "e.g. 'proposer-v1/phraser-v1'"
            }
         }
      }
   },
   "$defs": {
      "range": {
         "type": "object",
         "required": [
            "low",
            "typ",
            "high"
         ],
         "additionalProperties": false,
         "properties": {
            "low": {
               "type": "number"
            },
            "typ": {
               "type": "number"
            },
            "high": {
               "type": "number"
            }
         }
      },
      "suggestion": {
         "type": "object",
         "required": [
            "id",
            "type",
            "headline",
            "change",
            "saving_kg",
            "saving_pct",
            "why",
            "tradeoff",
            "confidence",
            "needs_other_party"
         ],
         "additionalProperties": false,
         "properties": {
            "id": {
               "type": "string",
               "pattern": "^S\\d+$"
            },
            "type": {
               "type": "string",
               "enum": [
                  "reschedule",
                  "share",
                  "coordinate",
                  "substitute",
                  "method",
                  "share_material"
               ],
               "description": "Bookings: reschedule = move in time to a cleaner grid hour; share = use a device already running / another unit; coordinate = merge or batch energy-intensive activities. Plans: substitute = another consumable (including a reusable one); method = an equivalent procedure; share_material = shared stock or run with another group. Plan types always come from data/equivalences.csv."
            },
            "booking_ids": {
               "type": "array",
               "minItems": 1,
               "items": {
                  "type": "string"
               }
            },
            "line_ids": {
               "type": "array",
               "minItems": 1,
               "maxItems": 1,
               "items": {
                  "type": "string",
                  "pattern": "^L\\d+$"
               }
            },
            "headline": {
               "type": "string",
               "maxLength": 80,
               "description": "One short line the researcher reads first"
            },
            "change": {
               "type": "object",
               "description": "Machine-readable change the UI applies on Accept.",
               "additionalProperties": false,
               "properties": {
                  "new_start": {
                     "type": "string",
                     "description": "YYYY-MM-DD HH:MM"
                  },
                  "new_end": {
                     "type": "string"
                  },
                  "new_equipment_id": {
                     "type": "string"
                  },
                  "merge_into_booking_id": {
                     "type": "string"
                  },
                  "line_id": {
                     "type": "string",
                     "pattern": "^L\\d+$"
                  },
                  "equivalence_id": {
                     "type": "string",
                     "pattern": "^EQ-\\d{3}$",
                     "description": "row of data/equivalences.csv"
                  },
                  "alternative_id": {
                     "type": "string",
                     "description": "key into data/consumables.csv"
                  },
                  "new_quantity": {
                     "type": "number",
                     "description": "quantity × ratio of the equivalence, computed by code"
                  }
               }
            },
            "saving_kg": {
               "$ref": "#/$defs/range"
            },
            "saving_pct": {
               "type": "number",
               "description": "Saving relative to the booking(s) changed"
            },
            "why": {
               "type": "string",
               "maxLength": 200
            },
            "tradeoff": {
               "type": "string",
               "maxLength": 160,
               "description": "What the researcher gives up. Never empty."
            },
            "confidence": {
               "type": "string",
               "enum": [
                  "low",
                  "medium",
                  "high"
               ],
               "description": "Lowest confidence among the equipment values or emission factors involved (estimate → low, derived → medium, measured → high)"
            },
            "needs_other_party": {
               "type": "boolean",
               "description": "true if another group must agree (e.g. merging autoclave cycles). The other group is never named to the researcher."
            },
            "requires_validation": {
               "type": "boolean",
               "description": "Plans: the lab must validate the change for the protocol first (from data/equivalences.csv)."
            }
         },
         "oneOf": [
            {
               "required": [
                  "booking_ids"
               ]
            },
            {
               "required": [
                  "line_ids"
               ]
            }
         ]
      }
   }
}
